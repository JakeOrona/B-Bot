# Twitter/X Scraper Configuration

# Twitter authentication credentials
TWITTER_USERNAME=yourusername
TWITTER_PASSWORD=yourpassword

# Google Drive integration
ENABLE_GOOGLE_DRIVE=false
GOOGLE_DRIVE_CREDENTIALS_PATH=config/google-drive-credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id

# Download configuration
DOWNLOAD_PATH=downloads
MAX_IMAGES=100
MAX_SCROLLS=250
DELAY_BETWEEN_SCROLLS=800
RATE_LIMIT_DELAY=2000
MAX_RETRIES=3
RETRY_DELAY=1000

# Progress logging configuration
LOG_MODE=concise           # 'concise' or 'verbose'
SHOW_PROGRESS_BARS=true
LOG_TO_FILE=true
SEPARATE_LOG_FILES=true    # Use separate files for concise and verbose logs

# Concurrent processing configuration
ENABLE_CONCURRENT_PROCESSING=true
MAX_CONCURRENT_PROFILES=3
EXTRACTION_TIMEOUT_MS=300000
QUEUE_MAX_SIZE=100
