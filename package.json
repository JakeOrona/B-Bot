{
  "name": "twitter-image-scraper",
  "version": "1.0.0",
  "description": "Twitter/X image scraper for downloading images from artist profiles",
  "main": "dist/index.js",
  "bin": {
    "twitter-scraper": "./bin/scraper.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "scrape": "ts-node src/index.ts --scrape-only",
    "upload": "ts-node src/index.ts --upload-only",
    "debug-drive": "ts-node src/index.ts --debug-drive",
    "help": "node ./bin/help.js",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:headed": "npx playwright test --headed",
    "dev": "ts-node-dev --respawn src/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/node": "^24.0.3",
    "@types/yargs": "^17.0.33",
    "dotenv": "^16.5.0",
    "googleapis": "^150.0.1",
    "playwright": "^1.53.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "ts-node-dev": "^2.0.0"
  }
}
